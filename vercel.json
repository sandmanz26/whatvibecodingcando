{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/content",
      "destination": "/content/",
      "permanent": false
    },
    {
      "source": "/saas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/saas/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/saas/:path*",
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/__reset",
      "destination": "/content/__reset",
      "permanent": false
    },
    {
      "source": "/content/__reset/",
      "destination": "/content/__reset",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/content/__reset",
      "destination": "/content/index.html"
    }
  ],
  "headers": [
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
